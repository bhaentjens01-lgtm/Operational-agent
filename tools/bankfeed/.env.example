# Kopieer naar .env (staat in .gitignore) en vul in. Nooit committen.

# Enable Banking: applicatie-ID (= naam van het .pem-bestand) en pad naar de private key
EB_APPLICATION_ID=
EB_PRIVATE_KEY_PATH=/pad/buiten/dropbox/en/git/<application-id>.pem
EB_REDIRECT_URL=https://enablebanking.com/

# Lokale datamap (buiten git)
BANKFEED_DATA_DIR=data/bankfeed

# Whitelist: enkel privérekeningen op naam van Bart alleen (komma-gescheiden)
BANKFEED_ALLOWED_IBANS=

# IBAN's van de eigen vennootschappen (lijst van Lex); altijd geweigerd, en S1-signaal
BANKFEED_COMPANY_IBANS=

# Drempel voor het signaal "grote uitgave" (EUR)
BANKFEED_LARGE_OUTFLOW_EUR=5000

# Optioneel, standaard uit (eerst akkoord van Lex, art. 28 AVG)
# BANKFEED_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
